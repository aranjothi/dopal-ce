{
  "manifest_version": 3,
  "name": "DoPal",
  "version": "0.1.0",
  "description": "Your productivity pet companion",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms"]
}
